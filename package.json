{
  "name": "trendiverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "pages:build": "npx @cloudflare/next-on-pages",
    "deploy:cloudflare": "npm run pages:build && wrangler pages deploy .vercel/output/static --project-name trendiverse",
    "migrate:cf": "wrangler d1 migrations apply trendiverse-db --remote",
    "migrate:local": "wrangler d1 migrations apply trendiverse-db --local",
    "migrate:preview:list": "node --import tsx scripts/d1-preview.ts list",
    "migrate:preview:apply": "node --import tsx scripts/d1-preview.ts apply",
    "seed:db": "node scripts/seed.js",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.7",
    "@cloudflare/workers-types": "^4.20241004.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "wrangler": "^3.90.0"
  }
}
